# Flask Configuration
SECRET_KEY=your_secret_key_here_change_in_production
DEBUG=False
PORT=5000

# Upload Configuration
UPLOAD_FOLDER=uploads

# Admin Credentials (CHANGE THESE IN PRODUCTION!)
ADMIN_USER=your_admin_email@example.com
ADMIN_PASS=your_secure_password
ADMIN_SECRET_URL=your_secret_admin_path

# File Paths (relative to UPLOAD_FOLDER)
MSG_FILE_PATH=uploads/messages.json
TRAFFIC_FILE_PATH=uploads/traffic.json
ROTATOR_FILE_PATH=uploads/rotator.json
CONFIG_FILE_PATH=uploads/config.json
GALLERY_FILE_PATH=uploads/gallery.json

# Logging
LOG_FILE_PATH=app.log
